/* A slowing focus gesture over a continuously rotating specimen; layers are authored in the UXML. */
#title-screen { display: none; }
.loading-screen { background-color: rgb(0, 0, 0); overflow: hidden; }
.loading-artboard { position: absolute; left: 50%; top: 50%; width: 1920px; height: 1080px; margin-left: -960px; margin-top: -540px; overflow: hidden; }
.loading-art { position: absolute; background-size: 100% 100%; background-repeat: no-repeat; }
.loading-world { transform-origin: 50% 50%; opacity: 1; }
/* A fixed, centered microscope. The left hand grips its adjustment knob. */
.loading-microscope-assembly { opacity: 0; scale: 1.8 1.8; transform-origin: 50% 50%; }
.loading-title-group {
    position: absolute; left: 50%; top: 50%; width: 360px; height: 180px;
    margin-left: -180px; margin-top: -90px;
    overflow: visible; opacity: 0;
}
.loading-game-title {
    position: absolute; left: 50%; top: 50%; width: 220px; height: 121px;
    margin-left: -110px; margin-top: -60.5px;
    background-size: 100% 100%; background-repeat: no-repeat;
    background-image: url("project://database/Assets/Via/Art/UI/Title/Images/UI_MainLogo.png?fileID=2800000&guid=f03168c36dd152948a53d2cdb7dcc015&type=3");
    opacity: 1;
}
/* Preserve the menu logo's white/gold lettering and native blue/gold glow. */
.loading-title-halo {
    opacity: 0.4;
}
.loading-title-bloom {
    opacity: 0.65;
}
#loading-microscope { left: 594.5px; top: 194.5px; width: 731px; height: 691px;
    background-image: url("project://database/Assets/Via/Art/UI/Title/Images/UI_Microscope.png?fileID=2800000&guid=eedf75cbb75e25747b0b507dad522f3d&type=3"); }
#loading-hand { left: 478px; top: 316px; width: 464px; height: 318px;
    transform-origin: 87% 69%;
    background-image: url("project://database/Assets/Via/Art/UI/Title/Images/UI_Hand.png?fileID=2800000&guid=41713f5b3616d7d488dd8a12dbde9129&type=3"); }
