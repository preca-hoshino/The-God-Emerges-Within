.paradigm-eight { background-image: url("project://database/Assets/Via/Art/UI/Gameplay/UI_Icon_EightShape.png?fileID=21300000&guid=03d6ee8032f75934397daa86a4ccf0c4&type=3"); }
.paradigm-polyline { background-image: url("project://database/Assets/Via/Art/UI/Gameplay/UI_Icon_Polyline.png?fileID=21300000&guid=7b2f4c9a8e1d4b6f93c05a2d7e8f1a34&type=3"); }
.paradigm-polygon { background-image: url("project://database/Assets/Via/Art/UI/Gameplay/UI_Icon_Polygon.png?fileID=21300000&guid=d1a6e93f4c2b47a8b0e5d1c79a3f62b8&type=3"); }
#tool-attractor .gameplay-tool-icon { background-image: url("project://database/Assets/Via/Art/UI/Gameplay/UI_Button_Attractor.png?fileID=21300000&guid=0e6d2f2d62a2fa942b53b649df2bad44&type=3"); }
