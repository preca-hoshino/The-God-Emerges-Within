#tool-branch .gameplay-tool-icon { background-image: url("project://database/Assets/Via/Art/UI/Gameplay/UI_Button_Branch.png?fileID=21300000&guid=f91384fee302873419fc4f4a6356a4f8&type=3"); }
#tool-reshape .gameplay-tool-icon { background-image: url("project://database/Assets/Via/Art/UI/Gameplay/UI_Button_Reshape.png?fileID=21300000&guid=de2755ca3fa0ee741ba4bc9308ff234c&type=3"); }

#gameplay-artboard .teaching-hud { left: 455px; top: 215px; width: 420px; }
#gameplay-artboard .opponent-target { height: 300px; } .opponent-target .gameplay-paradigm-caption { height: 76px; font-size: 28px; }
